{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/auth/login.js": {
      "maxDuration": 60
    },
    "api/auth/register.js": {
      "maxDuration": 60
    },
    "api/auth/logout.js": {
      "maxDuration": 60
    }
  }
}
