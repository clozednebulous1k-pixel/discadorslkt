rules_version = '2';

// Todo acesso ao banco passa pelo servidor (Firebase Admin SDK), que ignora estas regras
// e aplica login, perfis e permissões por carteira. Navegadores e apps nunca acessam o
// Firestore diretamente, então tudo que vier de fora é bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
